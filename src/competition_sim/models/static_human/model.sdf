<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="static_human">
    <static>true</static>
    <link name="link">
      <!-- Torso / Body -->
      <collision name="body_collision">
        <pose>0 0 0.85 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>1.7</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="body_visual">
        <pose>0 0 0.85 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>1.7</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.0 0.6 0.8 1.0</ambient>
          <diffuse>0.0 0.7 0.9 1.0</diffuse>
        </material>
      </visual>

      <!-- Head -->
      <visual name="head_visual">
        <pose>0 0 1.85 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.15</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.9 0.75 0.65 1.0</ambient>
          <diffuse>0.9 0.75 0.65 1.0</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
