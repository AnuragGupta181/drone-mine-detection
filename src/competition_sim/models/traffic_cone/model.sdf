<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="traffic_cone">
    <static>true</static>
    <link name="link">
      <!-- Base Plate -->
      <collision name="base_collision">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <box>
            <size>0.35 0.35 0.04</size>
          </box>
        </geometry>
      </collision>
      <visual name="base_visual">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <box>
            <size>0.35 0.35 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.15 0.15 0.15 1.0</diffuse>
        </material>
      </visual>

      <!-- Cone Body -->
      <collision name="cone_collision">
        <pose>0 0 0.27 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.50</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="cone_visual">
        <pose>0 0 0.27 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.50</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1.0 0.35 0.0 1.0</ambient>
          <diffuse>1.0 0.40 0.0 1.0</diffuse>
          <specular>0.5 0.5 0.5 1.0</specular>
        </material>
      </visual>
      
      <!-- Reflective Stripe -->
      <visual name="stripe_visual">
        <pose>0 0 0.35 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.125</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.9 0.9 0.9 1.0</ambient>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
