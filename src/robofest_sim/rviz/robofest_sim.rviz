Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Grid1
        - /Ground Truth Mines1
        - /Ground Truth Obstacles1
        - /Start Zone1
        - /Exit Zone1
        - /Planning Markers1
        - /Safe Path Drone 01
        - /Safe Path Drone 11
        - /Safe Path Drone 21
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 20
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 50
      Reference Frame: world
      Value: true

    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Drone Marker (Start Zone)
      Namespaces:
        drone_marker: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter Size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ground_truth/drone_marker
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Ground Truth Mines
      Namespaces:
        ground_truth_mines: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter Size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ground_truth/mines
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Ground Truth Obstacles
      Namespaces:
        ground_truth_obstacles: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter Size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ground_truth/obstacles
      Value: true

    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Start Zone
      Namespaces:
        start_zone: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter Size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ground_truth/start_zone
      Value: true

    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Exit Zone
      Namespaces:
        exit_zone: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter Size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ground_truth/exit_zone
      Value: true

    # ── Safe Path Planner Outputs ────────────────────────────────────────────

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Planning Markers
      Namespaces:
        mine_exclusion: true
        mine_body: true
        obstacle_zone: true
        start_zone: true
        exit_zone: true
        zone_labels: true
        safe_path_0: true
        safe_path_1: true
        safe_path_2: true
        path_waypoints_0: true
        path_waypoints_1: true
        path_waypoints_2: true
        drone_labels: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        Filter Size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /planning/markers
      Value: true

    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Safe Path Drone 0
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        Filter Size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /planning/safe_path/drone_0
      Value: true
      Color: 0; 230; 0
      Alpha: 1.0
      Line Style: Lines
      Line Width: 0.12

    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Safe Path Drone 1
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        Filter Size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /planning/safe_path/drone_1
      Value: true
      Color: 0; 200; 255
      Alpha: 1.0
      Line Style: Lines
      Line Width: 0.12

    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Safe Path Drone 2
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        Filter Size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /planning/safe_path/drone_2
      Value: true
      Color: 255; 230; 0
      Alpha: 1.0
      Line Style: Lines
      Line Width: 0.12

    # ── SLAM + Sensor Displays ───────────────────────────────────────────────

    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: 2D SLAM Map
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Value: true
      Alpha: 0.6

    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: LiDAR Scan
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter Size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Value: true
      Size (m): 0.08
      Style: Flat Squares
      Color: 255; 80; 0

  Global Options:
    Background Color: 35; 35; 42
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 22
      Angle: 0
      X: 20
      Y: 0
      Name: Top-Down Field View
      Value: TopDownOrtho (rviz)
Window Geometry:
  Height: 900
  Width: 1400
