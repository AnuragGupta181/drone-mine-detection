<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="stage1_seeded">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.4 0.3 1.0</ambient>
            <diffuse>0.3 0.5 0.3 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Field Enclosure Walls (10m x 40m Field: X=[0,40], Y=[-5,5]) -->
    <model name="wall_north">
      <static>true</static>
      <pose>20.0 5.0 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>40.0 0.1 1.0</size></box></geometry><material><ambient>0.8 0.8 0.8 1.0</ambient></material></visual>
        <collision name="collision"><geometry><box><size>40.0 0.1 1.0</size></box></geometry></collision>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>20.0 -5.0 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>40.0 0.1 1.0</size></box></geometry><material><ambient>0.8 0.8 0.8 1.0</ambient></material></visual>
        <collision name="collision"><geometry><box><size>40.0 0.1 1.0</size></box></geometry></collision>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>0.0 0.0 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.1 10.0 1.0</size></box></geometry><material><ambient>0.8 0.8 0.8 1.0</ambient></material></visual>
        <collision name="collision"><geometry><box><size>0.1 10.0 1.0</size></box></geometry></collision>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>40.0 0.0 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.1 10.0 1.0</size></box></geometry><material><ambient>0.8 0.8 0.8 1.0</ambient></material></visual>
        <collision name="collision"><geometry><box><size>0.1 10.0 1.0</size></box></geometry></collision>
      </link>
    </model>

    <!-- Start Zone Mat (X=[0, 5], Y=[-5, 5]) -->
    <model name="start_zone_mat">
      <static>true</static>
      <pose>2.5 0.0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>5.0 10.0 0.001</size></box></geometry>
          <material><ambient>0.1 0.6 0.1 0.7</ambient><diffuse>0.2 0.8 0.2 0.7</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Exit Zone Mat (X=[35, 40], Y=[-5, 5]) -->
    <model name="exit_zone_mat">
      <static>true</static>
      <pose>37.5 0.0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>5.0 10.0 0.001</size></box></geometry>
          <material><ambient>0.1 0.3 0.8 0.7</ambient><diffuse>0.2 0.4 0.9 0.7</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
